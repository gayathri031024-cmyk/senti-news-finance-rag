# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

APP_NAME=SentiNews Finance RAG
APP_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Postgres connection string (psycopg v3 driver)
# Matches the credentials in docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg://sentinews:sentinews@localhost:5432/sentinews

# Ingestion (Phase 2)
# CHUNK_SIZE / CHUNK_OVERLAP are in characters. See README for reasoning.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=storage/uploads

# Embeddings + hybrid retrieval (Phase 3)
# EMBEDDING_PROVIDER: "local" (no API key, deterministic, dev/test only —
# see services/embeddings/local_provider.py) or "openai" (real semantic
# embeddings, requires EMBEDDING_API_KEY).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
TOP_K=5

# RAG generation (Phase 4)
# LLM_PROVIDER: "local" (no API key, deterministic placeholder — does NOT
# produce real grounded answers, see services/llm/local_provider.py) or
# "openai" (real chat-completion answers, requires LLM_API_KEY).
LLM_PROVIDER=local
LLM_MODEL=local-echo-v1
LLM_API_KEY=
